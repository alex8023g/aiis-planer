# Строка подключения к PostgreSQL.
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aiis_planer?schema=public"

# Секрет для подписи сессий Better Auth.
# Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Внешний адрес приложения. Нужен для OAuth-редиректов.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth. Создать в Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (тип Web application). В "Authorized redirect URIs" добавить:
# http://localhost:3000/api/auth/callback/google (и такой же URL для прода).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Кому будут видны демо-проекты из prisma/seed.ts. Если не задать — всем, кто
# уже входил в приложение. Список через запятую.
SEED_MEMBER_EMAILS=""

# Кого prisma/seed.ts поднимет до роли admin (видит и меняет все проекты).
# Роли больше нигде не выдаются, так что хотя бы один адрес здесь нужен.
# Человек должен хотя бы раз войти через Google, иначе поднимать некого.
SEED_ADMIN_EMAILS=""

# MinIO — хранилище сканов договоров. Локально поднимается в docker:
# docker run -d --name minio -p 9000:9000 -p 9001:9001 \
#   -e MINIO_ROOT_USER=... -e MINIO_ROOT_PASSWORD=... minio/minio server /data --console-address ":9001"
# Ключи — те же MINIO_ROOT_USER/MINIO_ROOT_PASSWORD; их же показывает
# веб-консоль на http://localhost:9001. Бакет приложение создаёт само.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="contracts"
