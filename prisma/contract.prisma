// Contract registries: rows imported from the EPR, RN-Energo and SRO workbooks,
// their stages and the contract scans stored in MinIO.

enum ContractSource {
  /// Реестр ЭПР Заказчик: мы заказчик, контрагент — исполнитель.
  epr_customer
  /// Реестр РН-Энерго: мы исполнитель, заказчик один — РН-Энерго.
  rn_energo
  /// Реестр СРО: мы исполнитель, заказчик у каждого договора свой.
  sro
}

/// Строка реестра договоров. Источники разные, но набор полей общий;
/// то, что не разложилось по колонкам, лежит в raw.
model Contract {
  id            String          @id @default(cuid())
  source        ContractSource
  /// Год листа в реестре, а не год подписания: они иногда расходятся.
  registryYear  Int
  number        String
  /// Лист и номер строки в исходной книге: номер договора не уникален —
  /// в реестрах один и тот же номер встречается у разных договоров.
  sourceSheet   String
  sourceRow     Int
  signedAt      DateTime?
  counterparty  String
  objectName    String?
  subject       String
  /// null, если в реестре вместо суммы текст — тогда см. amountNote.
  amount        Decimal?        @db.Decimal(14, 2)
  amountNote    String?
  /// Только НДС. В реестрах ЭПР и СРО это одна колонка с dsNote, но пишут
  /// в неё и ставку, и состояние допсоглашения — разводим их при разборе.
  vatNote       String?
  /// Состояние дополнительного соглашения («ДС № 1 согласовано», «закрыт»).
  dsNote        String?
  termText      String?
  startsAt      DateTime?
  endsAt        DateTime?
  statusText    String?
  originalState String?
  /// Исходная строка целиком: реестры грязные, без неё не перепроверить.
  raw           Json
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  stages        ContractStage[]
  files         ContractFile[]

  @@unique([source, registryYear, sourceSheet, sourceRow])
  @@index([source, registryYear])
  @@index([number])
  @@index([signedAt])
  @@map("contract")
}

/// Этап договора. Есть только у РН-Энерго: там этапы вынесены на отдельные
/// листы книги и связаны с реестром гиперссылками.
model ContractStage {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  no         Int
  name       String
  /// Стоимость этапа: есть не на всех листах реестра.
  amount     Decimal?  @db.Decimal(14, 2)
  statusText String?
  closedAt   DateTime?
  dueAt      DateTime?

  @@unique([contractId, no])
  @@index([contractId])
  @@map("contract_stage")
}

/// Скан договора в MinIO: в базе — метаданные, сам файл лежит в бакете
/// (см. src/lib/minio.ts).
///
/// onDelete: Cascade убирает эти строки вместе с договором, но объекты в MinIO
/// остаются: база про бакет ничего не знает. Удаления договоров в интерфейсе
/// сейчас нет; когда появится — чистить бакет придётся там же, иначе в нём
/// накопятся файлы, на которые никто не ссылается.
model ContractFile {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Ключ объекта в бакете — он же путь к файлу, поэтому уникален.
  objectKey   String   @unique
  /// Имя файла как у пользователя на диске: его отдаём при скачивании, а в
  /// ключе объекта лежит очищенный вариант.
  fileName    String
  contentType String
  size        Int
  /// Почта загрузившего, а не id: пользователя могут удалить, а история
  /// загрузок должна пережить это.
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([contractId])
  @@map("contract_file")
}
