// Measurement points (ТИ) from the survey, their groups and the equipment on
// them: meters, current and voltage transformers, USPD, modems, SIM cards.

/// Состояние работы по ТИ.
enum TiStatus {
  in_progress
  done
  /// Что-то мешает: нужно внимание.
  warning
}

/// Сейчас на ТИ стоит (current) или ставим взамен (new). Общий для счётчика и
/// модема: у обоих на ТИ бывает не больше одного каждого вида.
enum EquipmentState {
  current
  removed
  proposed
}

enum ModemKind {
  builtIn
  external
}

/// Класс напряжения, кВ. Список закрытый: классы стандартные, других на
/// объектах не бывает, и свободное число пустило бы в базу и «10.5», и «10 кВ».
/// Объявлены по возрастанию: Postgres сортирует enum в порядке объявления, и
/// сортировка по напряжению работает сама, без таблицы соответствий.
enum VoltageClass {
  kv0_2
  kv0_4
  kv6
  kv10
  kv35
  kv110
  kv220
  kv330
  kv750
}

/// Канал связи модема.
enum Channel {
  gprs
  csd
}

/// Схема включения счётчика: напрямую или через измерительные трансформаторы.
/// В опросе пишут «прям.», «полукос.», «косв.» — закрытый список, а не текст,
/// иначе в базу поедут все варианты сокращений.
enum WiringScheme {
  /// Прямого включения: без ТТ и ТН.
  direct
  /// Полукосвенного: через ТТ, без ТН.
  semiIndirect
  /// Косвенного: через ТТ и ТН.
  indirect
}

/// Точка измерения (ТИ) из опроса. Что на ней стоит — в дочерних таблицах:
/// у каждой ТИ свой набор оборудования, общего между ТИ нет.
model Ti {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// № ТИ на ОС. Строка: в опросе встречаются номера вида «3а».
  number          String
  name            String
  /// Класс напряжения ТИ. Необязателен: на опросе его записывают не всегда,
  /// и null здесь — «ещё не выяснили», а не «напряжения нет».
  uNom            VoltageClass?
  /// Схема включения счётчика. null — «ещё не выяснили», как и у uNom.
  wiring          WiringScheme?
  /// Существующий опрос счётчика — как записали на опросе: «нет», «да, по
  /// встр. модему», «Пирамида по GSM». Свободный текст: в одно да/нет с
  /// видом модема всё это не укладывается. null — «не выяснили».
  existingPolling String?
  /// Есть ли у счётчика свободный RS-485 — к нему подключают шкаф связи.
  /// null — «не выяснили».
  freeRs485       Boolean?
  /// Группа ТИ с общими УСПД, модемом, тех. решением, текстом опроса и
  /// примечанием. Группа есть у каждой ТИ — у одиночной своя: её заводят
  /// добавление ТИ, «Разъединить» и сиды. Колонка всё же необязательна ради
  /// SetNull, а не Cascade: удалённая группа не должна уносить сами ТИ.
  /// Группа должна быть из того же проекта, что и ТИ: связью это не выразить
  /// (составной ключ с SetNull обнулил бы и projectId), следят на записи.
  groupId         String?
  group           TiGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Порядок в таблице опроса: задаёт составитель.
  position        Int
  /// Заметки к самой ТИ — в отличие от примечания группы, общего для всех её
  /// ТИ.
  notes           String?
  status          TiStatus      @default(in_progress)
  /// Не больше двух: текущий и новый (см. @@unique в Meter).
  meters          Meter[]
  // ttId          String
  // tt            Tt            @relation(fields: [ttId], references: [id], onDelete: Cascade)
  tt              Tt[]
  tn              Tn[]
  connection      Connection?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId])
  @@index([groupId])
}

/// Группа ТИ, которые делят УСПД, модем, тех. решение, текст опроса и
/// примечание. Всё общее висит на группе, а не на ТИ: так у ТИ одной группы
/// оно совпадает само собой — разойтись им не на чем. Каждого вида у группы не
/// больше одного (@unique groupId в дочерних таблицах).
/// Группа висит на проекте, а не только на своих ТИ: удаление проекта уносит
/// её каскадом вместе со всем общим. Через ТИ каскад не дошёл бы — ТИ ссылается
/// на группу, а не группа на ТИ, и удалённая ТИ свою группу не трогает.
/// Группа, из которой ушли все ТИ, остаётся до удаления проекта — убирать её
/// раньше или нет, решает код, который переносит ТИ.
model TiGroup {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tis               Ti[]
  uspd              Uspd?
  modem             Modem?
  technicalSolution TechnicalSolution?
  sidePolling       SidePolling?
  notes             TisNotes?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([projectId])
}

/// Прибор учёта ТИ. Поля необязательны: у нового счётчика тип и номер
/// появляются позже, а соответствие требованиям у текущего выясняют не сразу.
model Meter {
  id            String         @id @default(cuid())
  tiId          String
  ti            Ti             @relation(fields: [tiId], references: [id], onDelete: Cascade)
  state         EquipmentState
  type          String?
  number        String?
  isCompliant   Boolean?
  dateInstalled DateTime?      @db.Date
  dateRemoved   DateTime?      @db.Date

  @@unique([tiId, state])
}

/// Трансформаторы тока ТИ: по одному на фазу. Фазы B может не быть — при
/// двух ТТ (фазы A и C) её поля пустые.
model Tt {
  id            String    @id @default(cuid())
  tiId          String
  ti            Ti        @relation(fields: [tiId], references: [id], onDelete: Cascade)
  // tis     Ti[]
  typeA         String?
  typeB         String?
  typeC         String?
  numberA       String?
  numberB       String?
  numberC       String?
  /// Коэффициент трансформации, например «150/5».
  ratio         String?
  dateInstalled DateTime? @db.Date
  dateRemoved   DateTime? @db.Date
}

/// Трансформатор напряжения ТИ. Трёхфазный ТН — одна марка в typeA, typeB и
/// typeC пустые; три однофазных — по марке на фазу.
model Tn {
  id            String    @id @default(cuid())
  tiId          String
  ti            Ti        @relation(fields: [tiId], references: [id], onDelete: Cascade)
  typeA         String?
  typeB         String?
  typeC         String?
  numberA       String?
  numberB       String?
  numberC       String?
  /// Коэффициент трансформации, например «10000/100».
  ratio         String?
  dateInstalled DateTime? @db.Date
  dateRemoved   DateTime? @db.Date
}

/// Текст опроса группы ТИ.
model SidePolling {
  id          String  @id @default(cuid())
  groupId     String  @unique
  group       TiGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String?
}

/// УСПД: устройство сбора и передачи данных. Своя строка, а не поля в Ti —
/// один УСПД собирает данные с нескольких ТИ, и переписать его номер надо
/// один раз, а не в каждой ТИ по отдельности.
/// Тип и номер необязательны: на опросе записывают не всегда.
/// ТИ, которые опрашиваются через этот УСПД, — ТИ его группы.
model Uspd {
  id      String  @id @default(cuid())
  groupId String  @unique
  group   TiGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type    String?
  number  String?
}

/// Техническое решение по ТИ: что делаем на точке — как подключаемся, что
/// ставим. Своя строка, а не поле в Ti: в опросе одно и то же решение
/// повторяется на многих ТИ, и поправить его текст надо один раз, а не в каждой
/// ТИ по отдельности. ТИ, которые делаются по решению, — ТИ его группы.
model TechnicalSolution {
  id          String  @id @default(cuid())
  groupId     String  @unique
  group       TiGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
}

/// Модем: своя строка, а не поля в Ti — один модем обслуживает несколько ТИ,
/// и номер с SIM-картой у него общий на все.
/// ТИ, которые опрашиваются через этот модем, — ТИ его группы.
/// Заводится вместе с группой — пустым и с пустой SIM-картой: так IP и
/// прочее можно вписать сразу, не выясняя сперва, какой там модем.
model Modem {
  id      String     @id @default(cuid())
  groupId String     @unique
  group   TiGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// null — «ещё не выяснили»: модем заведён с группой, а какой он, пока
  /// неизвестно.
  kind    ModemKind?
  type    String?
  number  String?
  simCard SimCard?
}

/// Как опрашивается счётчик ТИ.
model Connection {
  id           String  @id @default(cuid())
  tiId         String  @unique
  ti           Ti      @relation(fields: [tiId], references: [id], onDelete: Cascade)
  /// Связной (сетевой) адрес счётчика.
  meterAddress String?
  port         String?
  /// GPRS по умолчанию: так опрашивается почти всё, CSD остаётся редким
  /// исключением.
  channel      Channel @default(gprs)
}

/// SIM-карта модема. Висит на модеме, а не на ТИ: при замене модема новая
/// карта приезжает вместе с ним, а старая остаётся при старом.
model SimCard {
  id       String  @id @default(cuid())
  modemId  String  @unique
  modem    Modem   @relation(fields: [modemId], references: [id], onDelete: Cascade)
  number   String?
  ip       String?
  provider String?
}

/// Примечание к группе ТИ.
model TisNotes {
  id          String  @id @default(cuid())
  groupId     String  @unique
  group       TiGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String?
}
