// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Значения совпадают со строками enum TaskStatus в src/lib/types.ts.
enum TaskStatus {
  not_started
  in_progress
  completed
}

/// Ключи этапов из типа Stages в src/lib/types.ts.
enum StageKind {
  ppo
  design
  supply
  smrPnr
  poverka
  algorithm
  metrology
}

/// Ключи подзадач всех этапов (см. Stages в src/lib/types.ts).
enum SubtaskKey {
  // ppo
  dogovor
  dopusk
  visit
  summary
  specification
  xml20000
  report
  // design
  tz
  rd
  td
  // supply
  request
  received
  assembled
  sent
  delivered
  // smrPnr
  allWorks
  // poverka
  arshin
  // algorithm
  collectData
  sendTask
  done
  // metrology
  documents
  vniims
  rosstandart
  poverkaAiis
}

model Project {
  id          String   @id @default(cuid())
  name        String
  /// Дата начала проекта, без времени.
  dateStart   DateTime @db.Date
  /// Длительность в днях.
  duration    Int      @default(0)
  responsible String?
  stages      Stage[]
  /// Кому проект виден и доступен для изменения. Пустого списка не бывает:
  /// проект без участников никто не смог бы ни открыть, ни удалить.
  members     ProjectMember[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Доступ к проекту. Хранится почта, а не связь с User, чтобы доступ можно было
/// выдать до первого входа человека в приложение.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Всегда в нижнем регистре: сравнение идёт по точному совпадению.
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([email])
}

/// Этап проекта. Отсутствие строки = этап не входит в проект (null в Stages).
model Stage {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      StageKind
  /// Длительность в днях.
  duration  Int
  subtasks  Subtask[]

  /// startAfter: этап начинается после завершения подзадачи другого этапа.
  startAfterStageId String?
  startAfterStage   Stage?      @relation("StageDependency", fields: [startAfterStageId], references: [id], onDelete: SetNull)
  startAfterSubtask SubtaskKey?
  dependents        Stage[]     @relation("StageDependency")

  @@unique([projectId, kind])
  @@index([startAfterStageId])
}

/// Подзадача этапа. status = null — подзадача неприменима к проекту.
model Subtask {
  id       String      @id @default(cuid())
  stageId  String
  stage    Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  key      SubtaskKey
  status   TaskStatus?
  /// Порядок отображения внутри этапа.
  position Int

  @@unique([stageId, key])
}

model IsDayOff {
  year      Int      @id
  days      String
  createdAt DateTime @default(now())

  @@unique([year])
  @@map("is_day_off")
}

/// Модели User/Session/Account/Verification ниже описывает Better Auth.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  /// Издатель OAuth-провайдера; вместе с accountId — ключ поиска аккаунта.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
