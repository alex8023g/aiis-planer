// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Значения совпадают со строками enum TaskStatus в src/lib/types.ts.
enum TaskStatus {
  not_started
  in_progress
  completed
}

/// Ключи этапов из типа Stages в src/lib/types.ts.
enum StageKind {
  ppo
  design
  supply
  smrPnr
  poverka
  algorithm
  metrology
}

/// Ключи подзадач всех этапов (см. Stages в src/lib/types.ts).
enum SubtaskKey {
  // ppo
  dogovor
  dopusk
  visit
  summary
  specification
  xml20000
  report
  // design
  tz
  rd
  td
  // supply
  request
  received
  assembled
  sent
  delivered
  // smrPnr
  allWorks
  // poverka
  arshin
  // algorithm
  collectData
  sendTask
  done
  // metrology
  documents
  vniims
  rosstandart
  poverkaAiis
}

/// Роль пользователя во всём приложении. Значения совпадают со строками
/// enum UserRole в src/lib/types.ts.
enum UserRole {
  /// Видит и меняет все проекты, включая те, где его нет в списке доступа.
  admin
  /// Меняет проекты, в списке доступа которых есть его почта.
  editor
  /// Только просмотр.
  viewer
  /// Вошёл, но роль ещё не выдали: не видит и не меняет ничего.
  pending
}

model Project {
  id          String             @id @default(cuid())
  name        String
  /// Дата начала проекта, без времени.
  dateStart   DateTime           @db.Date
  /// Длительность в днях.
  duration    Int                @default(0)
  responsible String?
  stages      Stage[]
  /// Кто из editor'ов может менять этот проект. На видимость список не влияет:
  /// проекты видны всем, кроме pending. Пустого списка не бывает: такой проект
  /// не смог бы изменить ни один editor, только admin.
  members     ProjectMember[]
  /// Точки учёта проекта: что именно на объекте считает электроэнергию.
  points      MeasurementPoint[]
  /// Объекты проекта: по ним раскладываются точки учёта и спецификации.
  facilities  Facility[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// Позиция спецификации объекта: наименование оборудования и количество.
/// Спецификация висит на объекте, а не на проекте: монтажнику нужен список по
/// конкретной площадке, а общий по проекту складывается из них.
model SpecificationItem {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String
  /// Модель (марка) оборудования. Необязательна: в спецификацию попадают и
  /// позиции без конкретной модели — кабель, монтажный материал.
  model      String?
  quantity   Int
  /// Порядок в спецификации: сортировать по названию нельзя — порядок позиций
  /// задаёт составитель.
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([facilityId])
}

/// Объект проекта: площадка, на которой стоят точки учёта и по которой собрана
/// спецификация. Своя строка, а не текст в точке: объект переименовывают
/// целиком, а опечатка в свободном поле развалила бы группу на две.
model Facility {
  id                 String              @id @default(cuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  /// Что на объекте есть сейчас: существующие приборы учёта, шкафы, каналы
  /// связи. Пустая строка, а не null: описание дописывают позже, но отдельного
  /// смысла у «описания нет» и «описание пустое» нет.
  currentDescription String              @default("")
  /// Техническое решение: что на объекте делаем — как подключаемся, что меняем,
  /// что ставим. Пустая строка по той же причине, что и у описания.
  technicalSolution  String              @default("")
  /// Порядок объектов в списке: задаёт составитель, по названию не сортируем.
  position           Int
  points             MeasurementPoint[]
  /// Спецификация: что и в каком количестве ставим на этом объекте.
  specification      SpecificationItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  /// Имя объекта уникально внутри проекта: повтор дал бы две группы вместо
  /// одной, и точки разошлись бы по ним незаметно.
  @@unique([projectId, name])
  @@index([projectId])
}

/// Точка учёта проекта: место, где стоит прибор учёта. Висит на проекте, а не
/// на решении: точки заводят по объекту целиком, ещё до того, как решения
/// разложены по шкафам.
model MeasurementPoint {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Объект, на котором стоит точка. Необязателен: точки заводят и до того, как
  /// объекты разложены, — такие показываем группой «Без объекта».
  /// SetNull, а не Cascade: удаление объекта не должно уносить точки — их
  /// набирали руками, и они переживают перекройку объектов.
  facilityId    String?
  facility      Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  /// Как точка подписана на объекте: фидер, ТП, ввод. Не уникально: одинаково
  /// названные точки на объекте бывают, различает их порядок в списке.
  name          String
  /// Модель прибора учёта. Необязательна: точку заводят и до того, как решено,
  /// какой счётчик на ней стоит.
  meterModel    String?
  /// Заводской номер прибора учёта. Необязателен по той же причине, что и
  /// модель, и появляется ещё позже неё: номер узнают, когда счётчик уже в
  /// руках. Не уникален: в базе живут точки разных проектов и разных лет, а
  /// замена счётчика на соседний номер — обычное дело.
  meterNumber   String?
  /// Где именно стоит прибор учёта: шкаф, опора, щитовая. Не то же, что объект:
  /// объект — площадка целиком, а это место на ней, куда идти монтажнику.
  /// Необязательно: на осмотре записывают не всегда.
  meterLocation String?
  /// Порядок точки внутри своего объекта (у точек без объекта — своя нумерация).
  position      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([facilityId])
}

/// Доступ к проекту. Хранится почта, а не связь с User, чтобы доступ можно было
/// выдать до первого входа человека в приложение.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Всегда в нижнем регистре: сравнение идёт по точному совпадению.
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([email])
}

/// Этап проекта. Отсутствие строки = этап не входит в проект (null в Stages).
model Stage {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      StageKind
  /// Длительность в днях.
  duration  Int
  subtasks  Subtask[]

  /// startAfter: этап начинается после завершения подзадачи другого этапа.
  startAfterStageId String?
  startAfterStage   Stage?      @relation("StageDependency", fields: [startAfterStageId], references: [id], onDelete: SetNull)
  startAfterSubtask SubtaskKey?
  dependents        Stage[]     @relation("StageDependency")

  @@unique([projectId, kind])
  @@index([startAfterStageId])
}

/// Подзадача этапа. status = null — подзадача неприменима к проекту.
model Subtask {
  id       String      @id @default(cuid())
  stageId  String
  stage    Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  key      SubtaskKey
  status   TaskStatus?
  /// Порядок отображения внутри этапа.
  position Int

  @@unique([stageId, key])
}

model IsDayOff {
  year      Int      @id
  days      String
  createdAt DateTime @default(now())

  @@unique([year])
  @@map("is_day_off")
}

/// Модели User/Session/Account/Verification ниже описывает Better Auth.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  /// Поле поверх схемы Better Auth: он отдаёт его в сессии, потому что оно
  /// объявлено в additionalFields (см. src/lib/auth.ts).
  role          UserRole  @default(pending)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  /// Издатель OAuth-провайдера; вместе с accountId — ключ поиска аккаунта.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
